{
    "description": "Traffic Flow Monitor (Vehicle Counting)",
    "sub_description": "Smart City / ITS / Road Monitoring",
    "usage": "smart_traffic",
    "adapter": "smart_traffic",
    "model": {
        "path": "./src/models/yolov8l-ppu.dxnn",
        "param": {
            "name": "YOLOV8L_PPU",
            "input_width": 640,
            "input_height": 640,
            "score_threshold": 0.3,
            "iou_threshold": 0.4,
            "last_activation": "sigmoid",
            "decoding_method": "yolo_basic",
            "box_format": "center",
            "final_outputs": [
                "output"
            ],
            "layer": [
                {
                    "name": "output",
                    "shape": [
                        1,
                        16128,
                        85
