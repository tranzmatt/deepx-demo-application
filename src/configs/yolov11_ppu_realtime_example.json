{
    "description": "PPE Compliance (Helmet + Mask + Vest)",
    "sub_description": "Industrial Safety / Construction / Warehousing",
    "usage": "detection",
    "model": {
        "path": "./src/models/ppe-detection-v11.dxnn",
        "param": {
            "name": "YOLOV11_PPU",
            "input_width": 640,
            "input_height": 640,
            "score_threshold": 0.3,
            "iou_threshold": 0.4,
            "last_activation": "sigmoid",
            "decoding_method": "yolo_basic",
            "box_format": "center",
            "final_outputs": [
                "output"
            ],
            "layer": [
                {
                    "name": "output",
                    "shape": [
                        1,
                        16128,
                        85
                    ]
                },
                {
                    "name": "378",
                    "stride": 8,
                    "anchor_width": [],
                    "anchor_height": []
                },
                {
                    "name": "439",
                    "stride": 16,
                    "anchor_width": [],
                    "anchor_height": []
                },
                {
                    "name": "500",
                    "stride": 32,
                    "anchor_width": [],
                    "anchor_height": []
                }
            ]
        }
    },
    "input": {
        "format": "RGB",
        "sources": [
            {
                "type": "camera",
                "path": "/dev/video0",
                "secondary_path": "rtsp://192.168.1.100:554/live",
                "secondary_type": "video"
            }
        ]
    },
    "output": {
        "description": "output type is used for post processing, that yolo, ssd, etc...",
        "classes": [
            "Hardhat",
            "Mask",
            "NO-Hardhat",
            "NO-Mask",
            "NO-Safety Vest",
            "Person",
            "Safety Cone",
            "Safety Vest",
            "Machinery",
            "Vehicle"
        ],
        "type": "yolo"
    },
    "application": {
        "description": "result of post-processing after inference",
        "type": "realtime",
        "resolution": [
            960,
            540
        ]
    }
}