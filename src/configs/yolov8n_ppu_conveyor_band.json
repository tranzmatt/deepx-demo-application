{
    "description": "Conveyor Inspector (Count + Classify)",
    "sub_description": "Warehousing / Sorting Lines / Packaging",
    "usage": "detection",
    "model": {
        "path": "./src/models/conveyor-images-v12.dxnn",
        "param": {
            "name": "YOLOV8N_PPU",
            "input_width": 640,
            "input_height": 640,
            "score_threshold": 0.3,
            "iou_threshold": 0.4,
            "last_activation": "sigmoid",
            "decoding_method": "yolo_basic",
            "box_format": "center",
            "final_outputs": [
                "output"
            ],
            "layer": [
                {
                    "name": "output",
                    "shape": [
                        1,
                        16128,
                        85
                    ]
                },
                {
                    "name": "378",
                    "stride": 8,
                    "anchor_width": [],
                    "anchor_height": []
                },
                {
                    "name": "439",
                    "stride": 16,
                    "anchor_width": [],
                    "anchor_height": []
                },
                {
                    "name": "500",
                    "stride": 32,
                    "anchor_width": [],
                    "anchor_height": []
                }
            ]
        }
    },
    "input": {
        "format": "RGB",
        "sources": [
            {
                "type": "video",
                "path": "src/videos/conveyor-band.mp4"
            }
        ]
    },
    "output": {
        "description": "output type is used for post processing, that yolo, ssd, etc...",
        "classes": [
            "cardboard",
            "glass",
            "metal",
            "paper",
            "plastic"
        ],
        "type": "yolo"
    },
    "application": {
        "description": "result of post-processing after inference",
        "type": "realtime",
        "resolution": [
            960,
            540
        ]
    }
}
